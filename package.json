{
  "name": "architecture-explorer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "tsx apps/server/src/main.ts",
    "web": "vite --config apps/web/vite.config.ts",
    "scan": "tsx apps/server/src/cli.ts scan",
    "watch": "tsx apps/server/src/cli.ts watch",
    "verify-index": "tsx apps/server/src/cli.ts verify",
    "test": "tsx --test tests/*.test.ts apps/web/src/*.test.ts apps/web/src/architecture/*.test.ts",
    "typecheck": "tsc --noEmit",
    "build": "vite build --config apps/web/vite.config.ts"
  },
  "dependencies": {
    "@xyflow/react": "12.12.0",
    "ajv": "8.20.0",
    "chokidar": "5.0.0",
    "elkjs": "0.12.0",
    "fastify": "5.12.7",
    "lucide-react": "1.59.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "happy-dom": "21.0.3",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.4"
  }
}
