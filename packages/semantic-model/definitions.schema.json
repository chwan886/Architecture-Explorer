{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://architecture-explorer.local/schema/semantic-definitions.json",
  "title": "Architecture Explorer semantic definitions",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "projectId",
    "flows"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0.0"
    },
    "projectId": {
      "$ref": "#/definitions/Id"
    },
    "flows": {
      "type": "array",
      "minItems": 0,
      "maxItems": 256,
      "items": {
        "$ref": "#/definitions/Flow"
      }
    }
  },
  "definitions": {
    "Id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
    },
    "Text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 20000
    },
    "Texts": {
      "type": "array",
      "maxItems": 256,
      "items": {
        "$ref": "#/definitions/Text"
      }
    },
    "Ids": {
      "type": "array",
      "maxItems": 8192,
      "uniqueItems": true,
      "items": {
        "$ref": "#/definitions/Id"
      }
    },
    "Path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024,
      "pattern": "^(?![A-Za-z]:)(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.\\.(?:/|$))[^:\u0000]+$"
    },
    "Selector": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": false,
      "properties": {
        "language": {
          "enum": [
            "csharp",
            "python",
            "json",
            "unity",
            "unknown"
          ]
        },
        "kinds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "project",
              "system",
              "module",
              "file",
              "class",
              "interface",
              "struct",
              "enum",
              "method",
              "function",
              "field",
              "property",
              "event",
              "parameter",
              "resource",
              "data"
            ]
          }
        },
        "qualifiedName": {
          "$ref": "#/definitions/Text"
        },
        "qualifiedNamePrefix": {
          "$ref": "#/definitions/Text"
        },
        "filePath": {
          "$ref": "#/definitions/Path"
        },
        "filePathPrefix": {
          "$ref": "#/definitions/Path"
        }
      }
    },
    "Hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "Origin": {
      "enum": [
        "curated",
        "rule-generated",
        "ai-suggested",
        "human-edited"
      ]
    },
    "Control": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "description",
        "anchorIds"
      ],
      "properties": {
        "kind": {
          "enum": [
            "condition",
            "loop",
            "async",
            "early-return",
            "request-boundary"
          ]
        },
        "description": {
          "$ref": "#/definitions/Text"
        },
        "anchorIds": {
          "$ref": "#/definitions/Ids"
        }
      }
    },
    "Binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "role",
        "anchorIds"
      ],
      "properties": {
        "id": {
          "$ref": "#/definitions/Id"
        },
        "sourceStepId": {
          "$ref": "#/definitions/Id"
        },
        "selector": {
          "$ref": "#/definitions/Selector"
        },
        "role": {
          "enum": [
            "implementation",
            "context"
          ]
        },
        "anchorIds": {
          "$ref": "#/definitions/Ids"
        },
        "expectedDeclarationHash": {
          "$ref": "#/definitions/Hash"
        }
      }
    },
    "Step": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "summary",
        "purpose",
        "detail",
        "inputs",
        "processing",
        "outputs",
        "changes",
        "sourceStepIds",
        "bindings",
        "controls",
        "origin"
      ],
      "properties": {
        "id": {
          "$ref": "#/definitions/Id"
        },
        "title": {
          "$ref": "#/definitions/Text"
        },
        "summary": {
          "$ref": "#/definitions/Text"
        },
        "purpose": {
          "$ref": "#/definitions/Text"
        },
        "detail": {
          "$ref": "#/definitions/Text"
        },
        "inputs": {
          "$ref": "#/definitions/Texts"
        },
        "processing": {
          "$ref": "#/definitions/Texts"
        },
        "outputs": {
          "$ref": "#/definitions/Texts"
        },
        "changes": {
          "$ref": "#/definitions/Texts"
        },
        "sourceStepIds": {
          "$ref": "#/definitions/Ids"
        },
        "bindings": {
          "type": "array",
          "minItems": 0,
          "maxItems": 64,
          "items": {
            "$ref": "#/definitions/Binding"
          }
        },
        "controls": {
          "type": "array",
          "minItems": 0,
          "maxItems": 128,
          "items": {
            "$ref": "#/definitions/Control"
          }
        },
        "origin": {
          "$ref": "#/definitions/Origin"
        }
      }
    },
    "Group": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "summary",
        "purpose",
        "detail",
        "inputs",
        "processing",
        "outputs",
        "changes",
        "childIds",
        "origin"
      ],
      "properties": {
        "id": {
          "$ref": "#/definitions/Id"
        },
        "title": {
          "$ref": "#/definitions/Text"
        },
        "summary": {
          "$ref": "#/definitions/Text"
        },
        "purpose": {
          "$ref": "#/definitions/Text"
        },
        "detail": {
          "$ref": "#/definitions/Text"
        },
        "inputs": {
          "$ref": "#/definitions/Texts"
        },
        "processing": {
          "$ref": "#/definitions/Texts"
        },
        "outputs": {
          "$ref": "#/definitions/Texts"
        },
        "changes": {
          "$ref": "#/definitions/Texts"
        },
        "childIds": {
          "$ref": "#/definitions/Ids"
        },
        "origin": {
          "$ref": "#/definitions/Origin"
        }
      }
    },
    "Flow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "sourceFlowId",
        "title",
        "description",
        "groups",
        "steps"
      ],
      "properties": {
        "id": {
          "$ref": "#/definitions/Id"
        },
        "sourceFlowId": {
          "$ref": "#/definitions/Id"
        },
        "title": {
          "$ref": "#/definitions/Text"
        },
        "description": {
          "$ref": "#/definitions/Text"
        },
        "groups": {
          "type": "array",
          "minItems": 0,
          "maxItems": 128,
          "items": {
            "$ref": "#/definitions/Group"
          }
        },
        "steps": {
          "type": "array",
          "minItems": 0,
          "maxItems": 512,
          "items": {
            "$ref": "#/definitions/Step"
          }
        }
      }
    }
  }
}
