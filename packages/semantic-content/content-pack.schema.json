{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://architecture-explorer.local/schema/semantic-content-pack.json",
  "title": "Optional data-only semantic content pack",
  "type": "object", "additionalProperties": false,
  "required": ["schemaVersion", "flows"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "projectId": { "type": "string", "pattern": "^[a-zA-Z0-9_-]{1,64}$" },
    "flows": { "type": "array", "maxItems": 256, "items": { "$ref": "#/definitions/Flow" } }
  },
  "definitions": {
    "Id": { "$ref": "https://architecture-explorer.local/schema/semantic-definitions.json#/definitions/Id" },
    "Text": { "$ref": "https://architecture-explorer.local/schema/semantic-definitions.json#/definitions/Text" },
    "Texts": { "$ref": "https://architecture-explorer.local/schema/semantic-definitions.json#/definitions/Texts" },
    "TextPatch": {
      "type": "object", "additionalProperties": false, "minProperties": 1,
      "properties": {
        "title": { "$ref": "#/definitions/Text" }, "summary": { "$ref": "#/definitions/Text" },
        "purpose": { "$ref": "#/definitions/Text" }, "detail": { "$ref": "#/definitions/Text" },
        "inputs": { "$ref": "#/definitions/Texts" }, "processing": { "$ref": "#/definitions/Texts" },
        "outputs": { "$ref": "#/definitions/Texts" }, "changes": { "$ref": "#/definitions/Texts" }
      }
    },
    "Control": {
      "type": "object", "additionalProperties": false, "required": ["kind", "description"],
      "properties": {
        "kind": { "enum": ["condition", "loop", "async", "early-return", "request-boundary"] },
        "description": { "$ref": "#/definitions/Text" },
        "anchorIds": { "type": "array", "maxItems": 8192, "uniqueItems": true, "items": { "$ref": "#/definitions/Id" } }
      }
    },
    "Step": {
      "type": "object", "additionalProperties": false, "required": ["sourceStepId"],
      "properties": {
        "sourceStepId": { "$ref": "#/definitions/Id" }, "text": { "$ref": "#/definitions/TextPatch" },
        "controls": { "type": "array", "maxItems": 256, "items": { "$ref": "#/definitions/Control" } }
      }
    },
    "Group": {
      "type": "object", "additionalProperties": false, "required": ["id", "stepIds"],
      "properties": {
        "id": { "$ref": "#/definitions/Id" }, "text": { "$ref": "#/definitions/TextPatch" },
        "stepIds": { "type": "array", "minItems": 1, "maxItems": 512, "uniqueItems": true, "items": { "$ref": "#/definitions/Id" } }
      }
    },
    "Flow": {
      "type": "object", "additionalProperties": false, "required": ["sourceFlowId"],
      "properties": {
        "sourceFlowId": { "$ref": "#/definitions/Id" }, "title": { "$ref": "#/definitions/Text" }, "description": { "$ref": "#/definitions/Text" },
        "steps": { "type": "array", "maxItems": 512, "items": { "$ref": "#/definitions/Step" } },
        "groups": { "type": "array", "maxItems": 512, "items": { "$ref": "#/definitions/Group" } }
      }
    }
  }
}
